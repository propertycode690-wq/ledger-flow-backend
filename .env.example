# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MySQL via XAMPP)
# Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/ledgerflow_db
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/ledgerflow_db"

# Client CORS Configuration
FRONTEND_URL="http://localhost:5173"

# JWT Authentication
JWT_SECRET="your-256-bit-secret-key-here-minimum-32-characters"
JWT_EXPIRES_IN="7d"
