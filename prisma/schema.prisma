// Prisma schema for LedgerFlow Invoice System (Phase 3: Customer, Product & Van Management)
// Target Engine: MySQL (via XAMPP ledgerflow_db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Delivery vans for daily route distribution (e.g. van1, van2, van3)
model Van {
  id        String     @id @db.VarChar(50)
  name      String     @db.VarChar(100)
  vehicle   String?    @db.VarChar(150)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  customers Customer[]
  orders    Order[]
  mileages  Mileage[]
  expenses  VehicleExpense[]

  @@map("vans")
}

// Customers / wholesale client accounts
model Customer {
  id             String    @id @db.VarChar(50)
  name           String    @db.VarChar(255)
  contactPerson  String?   @map("contact_person") @db.VarChar(255)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  address        String?   @db.Text
  vatNumber      String?   @map("vat_number") @db.VarChar(50)
  paymentTerms   Int       @default(14) @map("payment_terms")
  status         String    @default("Active") @db.VarChar(50)
  openingBalance Decimal   @default(0.00) @map("opening_balance") @db.Decimal(12, 2)
  notes          String?   @db.Text
  vanId          String?   @map("van_id") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  van            Van?      @relation(fields: [vanId], references: [id], onDelete: SetNull)
  users          User[]
  invoices       Invoice[]
  payments       Payment[]
  orders         Order[]

  @@index([vanId], map: "idx_customers_van_id")
  @@index([status], map: "idx_customers_status")
  @@map("customers")
}

// Products inventory catalog with wholesale pricing and default VAT rates
model Product {
  id           String        @id @db.VarChar(50)
  name         String        @db.VarChar(255)
  unit         String        @db.VarChar(50)
  defaultRate  Decimal       @default(0.00) @map("default_rate") @db.Decimal(10, 2)
  defaultVat   Decimal       @default(0.00) @map("default_vat") @db.Decimal(5, 2)
  category     String        @default("Produce") @db.VarChar(100)
  stock        Int           @default(0)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  invoiceItems  InvoiceItem[]
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]

  @@index([category], map: "idx_products_category")
  @@index([isActive], map: "idx_products_is_active")
  @@map("products")
}

// Authenticated users supporting Role-Based Access Control (RBAC)
// Roles: admin, accountant, customer
model User {
  id           String    @id @default(uuid()) @db.VarChar(36)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @db.VarChar(50)
  name         String    @db.VarChar(255)
  title        String?   @db.VarChar(100)
  customerId   String?   @map("customer_id") @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([role], map: "idx_users_role")
  @@index([customerId], map: "idx_users_customer_id")
  @@map("users")
}

// Company profile, VAT rates, banking & operational settings
model BusinessSettings {
  id                  Int      @id @default(1)
  businessName        String   @map("business_name") @db.VarChar(255)
  tradingName         String?  @map("trading_name") @db.VarChar(255)
  email               String   @db.VarChar(255)
  phone               String?  @db.VarChar(50)
  address             String?  @db.Text
  vatNumber           String?  @map("vat_number") @db.VarChar(50)
  companyNumber       String?  @map("company_number") @db.VarChar(50)
  currency            String   @default("GBP") @db.VarChar(10)
  currencySymbol      String   @default("£") @map("currency_symbol") @db.VarChar(5)
  invoicePrefix       String   @default("INV-2026-") @map("invoice_prefix") @db.VarChar(20)
  nextInvoiceNumber   Int      @default(90) @map("next_invoice_number")
  defaultPaymentTerms Int      @default(14) @map("default_payment_terms")
  defaultVatRate      Decimal  @default(20.00) @map("default_vat_rate") @db.Decimal(5, 2)
  bankName            String?  @map("bank_name") @db.VarChar(100)
  accountName         String?  @map("account_name") @db.VarChar(150)
  sortCode            String?  @map("sort_code") @db.VarChar(20)
  accountNumber       String?  @map("account_number") @db.VarChar(30)
  iban                String?  @db.VarChar(50)
  squareConnected     Boolean  @default(true) @map("square_connected")
  squareMerchantId    String?  @map("square_merchant_id") @db.VarChar(100)
  whatsAppStatus      String   @default("disconnected") @map("whatsapp_status") @db.VarChar(50)
  whatsAppPhone       String?  @map("whatsapp_phone") @db.VarChar(50)
  notesFooter         String?  @map("notes_footer") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

// Concurrency-safe sequential invoice numbering counter
model InvoiceSequence {
  prefix     String   @id @db.VarChar(20)
  nextNumber Int      @default(1) @map("next_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("invoice_sequences")
}

// Customer wholesale sales invoices
model Invoice {
  id             String    @id @default(cuid()) @db.VarChar(36)
  invoiceNumber  String    @unique @map("invoice_number") @db.VarChar(50)
  customerId     String    @map("customer_id") @db.VarChar(50)
  issueDate      DateTime  @map("issue_date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  reference      String?   @db.VarChar(100)
  status         String    @default("Draft") @db.VarChar(50)
  subtotal       Decimal   @default(0.00) @db.Decimal(12, 2)
  vatAmount      Decimal   @default(0.00) @map("vat_amount") @db.Decimal(12, 2)
  discountAmount Decimal   @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  total          Decimal   @default(0.00) @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0.00) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue     Decimal   @default(0.00) @map("balance_due") @db.Decimal(12, 2)
  notes          String?   @db.Text
  voidReason     String?   @map("void_reason") @db.VarChar(255)
  voidedAt       DateTime? @map("voided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          InvoiceItem[]
  allocations    PaymentAllocation[]

  @@index([customerId], map: "idx_invoices_customer_id")
  @@index([status], map: "idx_invoices_status")
  @@index([issueDate], map: "idx_invoices_issue_date")
  @@map("invoices")
}

// Line items on invoices preserving historical price and VAT snapshots
model InvoiceItem {
  id          String   @id @default(cuid()) @db.VarChar(36)
  invoiceId   String   @map("invoice_id") @db.VarChar(36)
  productId   String?  @map("product_id") @db.VarChar(50)
  description String   @db.VarChar(255)
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String   @default("kg") @db.VarChar(50)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  vatRate     Decimal  @default(0.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount   Decimal  @default(0.00) @map("vat_amount") @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId], map: "idx_invoice_items_invoice_id")
  @@index([productId], map: "idx_invoice_items_product_id")
  @@map("invoice_items")
}

// Customer payments and remittances
model Payment {
  id                String    @id @default(cuid()) @db.VarChar(36)
  paymentNumber     String    @unique @map("payment_number") @db.VarChar(50)
  customerId        String    @map("customer_id") @db.VarChar(50)
  amount            Decimal   @db.Decimal(12, 2)
  unallocatedAmount Decimal   @default(0.00) @map("unallocated_amount") @db.Decimal(12, 2)
  paymentDate       DateTime  @map("payment_date") @db.Date
  paymentMethod     String    @default("Bank Transfer") @map("payment_method") @db.VarChar(50)
  reference         String?   @db.VarChar(100)
  notes             String?   @db.Text
  status            String    @default("Completed") @db.VarChar(50)
  idempotencyKey    String?   @unique @map("idempotency_key") @db.VarChar(100)
  voidReason        String?   @map("void_reason") @db.VarChar(255)
  voidedAt          DateTime? @map("voided_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocations       PaymentAllocation[]

  @@index([customerId], map: "idx_payments_customer_id")
  @@index([paymentDate], map: "idx_payments_payment_date")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

// Allocations linking payments to invoices
model PaymentAllocation {
  id        String   @id @default(cuid()) @db.VarChar(36)
  paymentId String   @map("payment_id") @db.VarChar(36)
  invoiceId String   @map("invoice_id") @db.VarChar(36)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId], map: "idx_payment_allocations_payment_id")
  @@index([invoiceId], map: "idx_payment_allocations_invoice_id")
  @@map("payment_allocations")
}

// Daily wholesale customer orders
model Order {
  id          String      @id @default(cuid()) @db.VarChar(36)
  orderNumber String      @unique @map("order_number") @db.VarChar(50)
  customerId  String      @map("customer_id") @db.VarChar(50)
  vanId       String?     @map("van_id") @db.VarChar(50)
  orderDate   DateTime    @map("order_date") @db.Date
  status      String      @default("Confirmed") @db.VarChar(50)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  van         Van?        @relation(fields: [vanId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  @@index([customerId], map: "idx_orders_customer_id")
  @@index([orderDate], map: "idx_orders_order_date")
  @@index([vanId], map: "idx_orders_van_id")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

// Line items on daily orders capturing product snapshot and quantities
model OrderItem {
  id        String   @id @default(cuid()) @db.VarChar(36)
  orderId   String   @map("order_id") @db.VarChar(36)
  productId String?  @map("product_id") @db.VarChar(50)
  name      String   @db.VarChar(255)
  quantity  Decimal  @db.Decimal(10, 2)
  unit      String   @default("kg") @db.VarChar(50)
  unitPrice Decimal? @map("unit_price") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@map("order_items")
}

// Vehicle mileage tracking records
model Mileage {
  id                 String           @id @default(cuid()) @db.VarChar(36)
  mileageNumber      String           @unique @map("mileage_number") @db.VarChar(50)
  vanId              String?          @map("van_id") @db.VarChar(50)
  vehicle            String?          @db.VarChar(150)
  date               DateTime         @db.Date
  startMileage       Decimal          @map("start_mileage") @db.Decimal(10, 1)
  endMileage         Decimal          @map("end_mileage") @db.Decimal(10, 1)
  distance           Decimal          @db.Decimal(10, 1)
  distanceUnit       String           @default("miles") @map("distance_unit") @db.VarChar(20)
  purpose            String           @db.VarChar(255)
  rate               Decimal?         @db.Decimal(6, 2)
  estimatedExpense   Decimal?         @map("estimated_expense") @db.Decimal(10, 2)
  recordedInExpenses Boolean          @default(false) @map("recorded_in_expenses")
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  van                Van?             @relation(fields: [vanId], references: [id], onDelete: SetNull)
  expenses           VehicleExpense[]

  @@index([vanId], map: "idx_mileage_van_id")
  @@index([date], map: "idx_mileage_date")
  @@map("mileage_records")
}

// Vehicle-specific and mileage-related operational expenses
model VehicleExpense {
  id            String    @id @default(cuid()) @db.VarChar(36)
  expenseNumber String    @unique @map("expense_number") @db.VarChar(50)
  vanId         String?   @map("van_id") @db.VarChar(50)
  vehicle       String?   @db.VarChar(150)
  mileageId     String?   @map("mileage_id") @db.VarChar(36)
  date          DateTime  @db.Date
  category      String    @db.VarChar(100)
  description   String    @db.VarChar(255)
  amount        Decimal   @db.Decimal(10, 2)
  status        String    @default("Recorded") @db.VarChar(50)
  voidReason    String?   @map("void_reason") @db.VarChar(255)
  voidedAt      DateTime? @map("voided_at")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  van           Van?      @relation(fields: [vanId], references: [id], onDelete: SetNull)
  mileage       Mileage?  @relation(fields: [mileageId], references: [id], onDelete: SetNull)

  @@index([vanId], map: "idx_vehicle_expenses_van_id")
  @@index([date], map: "idx_vehicle_expenses_date")
  @@index([category], map: "idx_vehicle_expenses_category")
  @@index([mileageId], map: "idx_vehicle_expenses_mileage_id")
  @@map("vehicle_expenses")
}

// Suppliers for wholesale produce and goods procurement
model Supplier {
  id            String     @id @db.VarChar(50)
  name          String     @db.VarChar(255)
  contactPerson String?    @map("contact_person") @db.VarChar(255)
  email         String?    @db.VarChar(255)
  phone         String?    @db.VarChar(50)
  address       String?    @db.Text
  vatNumber     String?    @map("vat_number") @db.VarChar(50)
  paymentTerms  Int        @default(30) @map("payment_terms")
  status        String     @default("Active") @db.VarChar(50)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  purchases     Purchase[]

  @@map("suppliers")
}

// Wholesale produce purchases and supplier bills
model Purchase {
  id                String         @id @default(cuid()) @db.VarChar(36)
  purchaseNumber    String         @unique @map("purchase_number") @db.VarChar(50)
  supplierId        String?        @map("supplier_id") @db.VarChar(50)
  supplierName      String         @map("supplier_name") @db.VarChar(255)
  supplierInvoiceNo String?        @map("supplier_invoice_no") @db.VarChar(100)
  date              DateTime       @db.Date
  status            String         @default("Paid") @db.VarChar(50)
  subtotal          Decimal        @default(0.00) @db.Decimal(12, 2)
  vatAmount         Decimal        @default(0.00) @map("vat_amount") @db.Decimal(12, 2)
  total             Decimal        @default(0.00) @db.Decimal(12, 2)
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  supplier          Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items             PurchaseItem[]

  @@index([supplierId], map: "idx_purchases_supplier_id")
  @@index([date], map: "idx_purchases_date")
  @@index([status], map: "idx_purchases_status")
  @@map("purchases")
}

// Line items on purchase bills preserving product name snapshot, unit, price, and VAT
model PurchaseItem {
  id         String   @id @default(cuid()) @db.VarChar(36)
  purchaseId String   @map("purchase_id") @db.VarChar(36)
  productId  String?  @map("product_id") @db.VarChar(50)
  product    String   @db.VarChar(255)
  quantity   Decimal  @db.Decimal(10, 2)
  unit       String   @default("kg") @db.VarChar(50)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(10, 2)
  vatRate    Decimal  @default(0.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount  Decimal  @default(0.00) @map("vat_amount") @db.Decimal(10, 2)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productRef Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId], map: "idx_purchase_items_purchase_id")
  @@index([productId], map: "idx_purchase_items_product_id")
  @@map("purchase_items")
}

// General accounting income and expense cashflow transactions
model Transaction {
  id                 String   @id @default(cuid()) @db.VarChar(36)
  transactionNumber  String   @unique @map("transaction_number") @db.VarChar(50)
  date               DateTime @db.Date
  type               String   @db.VarChar(50) // Income, Expense, Purchase
  category           String   @db.VarChar(100)
  description        String   @db.VarChar(255)
  reference          String?  @db.VarChar(100)
  customerOrSupplier String?  @map("customer_or_supplier") @db.VarChar(255)
  netAmount          Decimal  @default(0.00) @map("net_amount") @db.Decimal(12, 2)
  vatAmount          Decimal  @default(0.00) @map("vat_amount") @db.Decimal(12, 2)
  grossAmount        Decimal  @default(0.00) @map("gross_amount") @db.Decimal(12, 2)
  status             String   @default("Completed") @db.VarChar(50)
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([date], map: "idx_transactions_date")
  @@index([type], map: "idx_transactions_type")
  @@index([category], map: "idx_transactions_category")
  @@map("transactions")
}

// Daily morning wholesale market purchasing fulfillment tracking
model ProcurementFulfillment {
  id           String   @id @default(cuid()) @db.VarChar(36)
  date         DateTime @db.Date
  productName  String   @map("product_name") @db.VarChar(255)
  purchasedQty Decimal  @default(0.00) @map("purchased_qty") @db.Decimal(10, 2)
  isCompleted  Boolean  @default(false) @map("is_completed")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([date, productName], map: "idx_fulfillment_date_product")
  @@index([date], map: "idx_fulfillment_date")
  @@map("procurement_fulfillments")
}


